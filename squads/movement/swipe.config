swipe_sources:
  - manifestos_archive
  - brand_movement_cases
  - social_movement_cases
  - community_playbooks
  - memetic_format_libraries
  - creator_collab_cases
  - pr_campaign_cases

curation_rules:
  - real_movements_only
  - include_context_and_outcome
  - tag_by_type_and_domain
  - tag_by_framework_used
  - include_cultural_context
  - include_what_worked_and_failed
  - never_include_copyrighted_verbatim

categories:
  manifestos:
    description: "Manifestos de marca, políticos, tech e causa social"
    tags: [manifesto, declaracao, convocacao]
  slogans:
    description: "Slogans icônicos, CTAs e frases de identidade"
    tags: [slogan, catchphrase, identidade]
  rituals:
    description: "Rituais de comunidade, marca, digitais e offline"
    tags: [ritual, engajamento, pertencimento]
  meme_formats:
    description: "Formatos meméticos por plataforma"
    tags: [meme, formato, viral, plataforma]
  creator_collabs:
    description: "Briefs e cases de colaboração com criadores"
    tags: [creator, influencer, collab, ugc]
  pr_angles:
    description: "Hooks e ângulos de PR para movimentos"
    tags: [pr, earned-media, thought-leadership]
  identity_systems:
    description: "Sistemas de identidade visual, linguística e simbólica"
    tags: [identidade, simbolo, visual, linguagem]
  community_building:
    description: "Onboarding, champions e mecânicas de engajamento"
    tags: [comunidade, onboarding, champion, engajamento]

quality_standards:
  min_context_lines: 10
  require_outcome: true
  require_framework_tag: true
  max_age_months: 24
